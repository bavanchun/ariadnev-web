---
// Section 5 — the evidence ledger.
//
// Three kinds of row, and the kind is stated in words as well as colour:
//
//   measured  — something was executed and observed
//   contract  — something is machine-checked as a static property
//   boundary  — something is deliberately not claimed or not yet permitted
//
// Every row links a source a reader can open, and every row names its limit.
// There are no testimonials, customer names, ratings, usage totals, or
// benchmark rankings here, because none of those exist as verifiable facts.
import { EVIDENCE } from "../data/marketing-facts";
---

<section class="shell section" id="evidence" aria-labelledby="evidence-heading" data-surface-context="reading">
  <div class="section__head">
    <p class="eyebrow">Evidence ledger</p>
    <h2 id="evidence-heading">What is proven, and where the proof stops</h2>
    <p class="lede">
      Each row states a claim, links the source it comes from, and says what it does not establish. A claim without a
      caveat is a claim nobody has checked.
    </p>
  </div>

  <ul class="ledger">
    {
      EVIDENCE.map((entry) => (
        <li class="ledger__row">
          <dl class="ledger__record">
            <div class="ledger__field ledger__field--kind">
              <dt>Kind</dt>
              <dd><span class="ledger__kind" data-kind={entry.kind}>{entry.kind}</span></dd>
            </div>
            <div class="ledger__field ledger__field--claim">
              <dt>Claim</dt>
              <dd>{entry.statement}</dd>
            </div>
            <div class="ledger__field">
              <dt>Source</dt>
              <dd><a href={entry.source}>{entry.sourceLabel}</a></dd>
            </div>
            <div class="ledger__field">
              <dt>Limit</dt>
              <dd>{entry.caveat}</dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ul>
</section>
