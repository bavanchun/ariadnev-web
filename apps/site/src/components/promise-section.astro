---
// Section 1 — the stable promise.
//
// One H1, three authored lines, a primary install action and a secondary docs
// action, and the Unix install command in the first screen. Nothing rotates and
// nothing is fetched: two visitors a year apart see the same words.
import { PROMISE, INSTALL, SITE, loadReleasePin } from "../data/marketing-facts";
import InstallCommand from "./install-command.astro";

// Read at build time. When Phase 10 has not written a pin, the release row is
// omitted entirely rather than filled with a guess.
const release = loadReleasePin();
---

<section class="shell promise" id="promise" aria-labelledby="promise-heading">
  <p class="eyebrow">{PROMISE.eyebrow}</p>
  <h1 id="promise-heading">{PROMISE.heading}</h1>

  <ul class="promise__lines">
    {PROMISE.lines.map((line) => <li>{line}</li>)}
  </ul>

  <div class="action-row">
    <a class="action action--primary" href="#install">Install ariadnev</a>
    <a class="action" href={SITE.docsEntry}>Read the docs</a>
  </div>

  <div class="command-list promise__command">
    <InstallCommand id="promise-install-unix" label={INSTALL.unixLabel} command={INSTALL.unixCommand} />
  </div>

  {
    release !== null && (
      <p class="release-pin">
        Current release{" "}
        <a href={release.releaseUrl}>
          {release.tag}
        </a>{" "}
        · published {release.publishedAt.slice(0, 10)}
      </p>
    )
  }
</section>
