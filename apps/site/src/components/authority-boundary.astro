---
// M01 macro 3 — authority boundary.
//
// Workflow lanes and provider projection share one macro but remain distinct
// subregions. The workflow subregion compares authority, gate, and recovery
// across the three canonical graphs; the provider subregion states one
// principle and links the generated matrix. Neither loses content in this
// composition; the outer section frames both under a shared boundary heading
// so a reader sees "what the graph is allowed to do" and "what a provider is
// allowed to do" as one truth, not two.
import WorkflowSection from "./workflow-section.astro";
import ProviderProjection from "./provider-projection.astro";
---

<section class="section authority" id="authority-boundary" aria-labelledby="authority-boundary-heading" data-surface-context="reading">
  <div class="shell authority__inner">
    <div class="section__head">
    <p class="eyebrow">Authority boundary</p>
    <h2 id="authority-boundary-heading">Where the graph stops, and where the provider stops</h2>
    <p class="lede">
      Workflow authority and provider projection are recorded separately below.
    </p>
    </div>

    <div class="authority__regions">
      <WorkflowSection />
      <ProviderProjection />
    </div>
  </div>
</section>
