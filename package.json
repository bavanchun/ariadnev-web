    "@cloudflare/workers-types": "5.20260809.1",
    "@mdx-js/mdx": "3.1.1",
    "@orama/orama": "3.1.18",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/fontkit": "2.0.9",
    "@types/mdx": "2.0.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.2.0",
    "fontkit": "2.0.4",
    "fumadocs-core": "16.14.2",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.2",
    "lighthouse": "13.4.1",
    "next": "16.3.0",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
