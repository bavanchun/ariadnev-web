{
  "name": "vcskill-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "26.0.0",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "build": "node scripts/run-workspace-command.mjs build",
    "build:compatibility": "node scripts/verify-toolchain-compatibility.mjs",
    "contracts": "pnpm --filter @vcskill/contracts test",
    "sync:release": "node scripts/run-reserved-command.mjs sync-release",
    "test": "node scripts/run-root-tests.mjs",
    "test:baseline": "node scripts/run-node-tests.mjs landing-consistency.test.mjs tests/contracts",
    "test:browser": "playwright test",
    "test:edge": "node scripts/run-node-tests.mjs workers/edge/test",
    "test:node": "node scripts/run-node-tests.mjs landing-consistency.test.mjs tests workers/edge/test",
    "test:qualification": "node scripts/run-reserved-command.mjs qualification",
    "test:vitest": "vitest run",
    "typecheck": "node scripts/run-workspace-command.mjs typecheck"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
