{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Framework-neutral execution cartography tokens for vcskill site and docs.",
  "$extensions": {
    "vcskill": {
      "requiredSurfaceRoles": [
        "color.canvas",
        "color.canvasRaised",
        "color.text",
        "color.textMuted",
        "color.link",
        "color.linkHover",
        "color.border",
        "color.borderStrong",
        "color.focus",
        "color.focusContrast",
        "color.selectionBackground",
        "color.selectionText",
        "color.statusSuccess",
        "color.statusWarning",
        "color.statusDanger",
        "color.statusInfo",
        "color.graphNode",
        "color.graphNodeActive",
        "color.graphNodeComplete",
        "color.graphNodeBlocked",
        "color.graphEdge",
        "color.graphEdgeActive",
        "color.gate",
        "color.checkpoint",
        "color.evidence"
      ],
      "surfaceAliases": [
        "color.canvas",
        "color.canvas-raised",
        "color.text",
        "color.text-muted",
        "color.link",
        "color.link-hover",
        "color.border",
        "color.border-strong",
        "color.focus",
        "color.focus-contrast",
        "color.selection-background",
        "color.selection-text",
        "color.status-success",
        "color.status-warning",
        "color.status-danger",
        "color.status-info",
        "color.graph-node",
        "color.graph-node-active",
        "color.graph-node-complete",
        "color.graph-node-blocked",
        "color.graph-edge",
        "color.graph-edge-active",
        "color.gate",
        "color.checkpoint",
        "color.evidence"
      ],
      "contrastPairs": [
        { "label": "site body", "foreground": "surface.site.color.text", "background": "surface.site.color.canvas", "minimum": 4.5 },
        { "label": "site muted text", "foreground": "surface.site.color.textMuted", "background": "surface.site.color.canvas", "minimum": 4.5 },
        { "label": "site link", "foreground": "surface.site.color.link", "background": "surface.site.color.canvas", "minimum": 4.5 },
        { "label": "site link hover", "foreground": "surface.site.color.linkHover", "background": "surface.site.color.canvas", "minimum": 4.5 },
        { "label": "site selection", "foreground": "surface.site.color.selectionText", "background": "surface.site.color.selectionBackground", "minimum": 4.5 },
        { "label": "site focus", "foreground": "surface.site.color.focus", "background": "surface.site.color.canvas", "minimum": 3 },
        { "label": "site strong border", "foreground": "surface.site.color.borderStrong", "background": "surface.site.color.canvas", "minimum": 3 },
        { "label": "site success", "foreground": "surface.site.color.statusSuccess", "background": "surface.site.color.canvas", "minimum": 4.5 },
        { "label": "site warning", "foreground": "surface.site.color.statusWarning", "background": "surface.site.color.canvas", "minimum": 4.5 },
        { "label": "site danger", "foreground": "surface.site.color.statusDanger", "background": "surface.site.color.canvas", "minimum": 4.5 },
        { "label": "site info", "foreground": "surface.site.color.statusInfo", "background": "surface.site.color.canvas", "minimum": 4.5 },
        { "label": "docs body", "foreground": "surface.docs.color.text", "background": "surface.docs.color.canvas", "minimum": 4.5 },
        { "label": "docs muted text", "foreground": "surface.docs.color.textMuted", "background": "surface.docs.color.canvas", "minimum": 4.5 },
        { "label": "docs link", "foreground": "surface.docs.color.link", "background": "surface.docs.color.canvas", "minimum": 4.5 },
        { "label": "docs link hover", "foreground": "surface.docs.color.linkHover", "background": "surface.docs.color.canvas", "minimum": 4.5 },
        { "label": "docs selection", "foreground": "surface.docs.color.selectionText", "background": "surface.docs.color.selectionBackground", "minimum": 4.5 },
        { "label": "docs focus", "foreground": "surface.docs.color.focus", "background": "surface.docs.color.canvas", "minimum": 3 },
        { "label": "docs strong border", "foreground": "surface.docs.color.borderStrong", "background": "surface.docs.color.canvas", "minimum": 3 },
        { "label": "docs success", "foreground": "surface.docs.color.statusSuccess", "background": "surface.docs.color.canvas", "minimum": 4.5 },
        { "label": "docs warning", "foreground": "surface.docs.color.statusWarning", "background": "surface.docs.color.canvas", "minimum": 4.5 },
        { "label": "docs danger", "foreground": "surface.docs.color.statusDanger", "background": "surface.docs.color.canvas", "minimum": 4.5 },
        { "label": "docs info", "foreground": "surface.docs.color.statusInfo", "background": "surface.docs.color.canvas", "minimum": 4.5 }
      ],
      "spacingRhythm": [
        "shared.space.1",
        "shared.space.2",
        "shared.space.3",
        "shared.space.4",
        "shared.space.6",
        "shared.space.8",
        "shared.space.12",
        "shared.space.16",
        "shared.space.24"
      ],
      "touchTarget": { "minimum": "shared.size.controlMinimum" },
      "focusRing": {
        "width": "shared.focus.ringWidth",
        "offset": "shared.focus.ringOffset",
        "colors": ["color.focus", "color.focusContrast"],
        "minimumContrast": 3
      },
      "reducedMotionMap": {
        "shared.motion.entrance.duration": "shared.motion.reduced.entranceDuration",
        "shared.motion.entrance.distance": "shared.motion.reduced.entranceDistance",
        "shared.motion.feedback.duration": "shared.motion.reduced.feedbackDuration",
        "shared.motion.feedback.distance": "shared.motion.reduced.feedbackDistance",
        "shared.motion.traversal.duration": "shared.motion.reduced.traversalDuration",
        "shared.motion.traversal.distance": "shared.motion.reduced.traversalDistance"
      }
    }
  },
  "private": {
    "$description": "Authored palette primitives. The generator resolves these into semantic roles and never emits palette variable names.",
    "color": {
      "$type": "color",
      "inkBlack": { "$value": { "colorSpace": "oklch", "components": [0.15, 0.018, 255] } },
      "inkRaised": { "$value": { "colorSpace": "oklch", "components": [0.21, 0.02, 255] } },
      "graphiteDark": { "$value": { "colorSpace": "oklch", "components": [0.32, 0.025, 255] } },
      "graphiteMuted": { "$value": { "colorSpace": "oklch", "components": [0.42, 0.025, 255] } },
      "graphiteStrong": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.03, 255] } },
      "graphiteLight": { "$value": { "colorSpace": "oklch", "components": [0.62, 0.025, 250] } },
      "coolWhite": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.008, 250] } },
      "coolWhiteSubtle": { "$value": { "colorSpace": "oklch", "components": [0.93, 0.012, 250] } },
      "coolWhiteMuted": { "$value": { "colorSpace": "oklch", "components": [0.74, 0.018, 250] } },
      "spectralBlueBright": { "$value": { "colorSpace": "oklch", "components": [0.72, 0.12, 250] } },
      "spectralBlue": { "$value": { "colorSpace": "oklch", "components": [0.62, 0.12, 250] } },
      "spectralBlueDark": { "$value": { "colorSpace": "oklch", "components": [0.43, 0.09, 250] } },
      "spectralBlueDeep": { "$value": { "colorSpace": "oklch", "components": [0.34, 0.07, 250] } },
      "copperBright": { "$value": { "colorSpace": "oklch", "components": [0.76, 0.1, 55] } },
      "copper": { "$value": { "colorSpace": "oklch", "components": [0.64, 0.11, 50] } },
      "copperDark": { "$value": { "colorSpace": "oklch", "components": [0.45, 0.08, 50] } },
      "evidenceBright": { "$value": { "colorSpace": "oklch", "components": [0.76, 0.1, 155] } },
      "evidenceDark": { "$value": { "colorSpace": "oklch", "components": [0.42, 0.08, 155] } },
      "dangerBright": { "$value": { "colorSpace": "oklch", "components": [0.7, 0.14, 25] } },
      "dangerDark": { "$value": { "colorSpace": "oklch", "components": [0.46, 0.12, 25] } }
    }
  },
  "shared": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": { "$value": ["VC Space Grotesk", "Arial", "sans-serif"] },
        "body": { "$value": ["VC Inter", "Arial", "sans-serif"] },
        "mono": { "$value": ["VC JetBrains Mono", "SFMono-Regular", "Cascadia Mono", "Roboto Mono", "monospace"] }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 }
      },
      "size": {
        "$type": "dimension",
        "caption": { "$value": { "value": 0.75, "unit": "rem" } },
        "bodySmall": { "$value": { "value": 0.875, "unit": "rem" } },
        "body": { "$value": { "value": 1, "unit": "rem" } },
        "lead": { "$value": { "value": 1.125, "unit": "rem" } },
        "headingSmall": { "$value": { "value": 1.5, "unit": "rem" } },
        "heading": { "$value": { "value": 2.25, "unit": "rem" } },
        "display": { "$value": { "value": 4.5, "unit": "rem" } }
      },
      "lineHeight": {
        "$type": "number",
        "tight": { "$value": 1.05 },
        "heading": { "$value": 1.15 },
        "body": { "$value": 1.65 },
        "code": { "$value": 1.55 }
      },
      "letterSpacing": {
        "$type": "dimension",
        "tight": { "$value": { "value": -0.03, "unit": "rem" } },
        "normal": { "$value": { "value": 0, "unit": "rem" } },
        "label": { "$value": { "value": 0.08, "unit": "rem" } }
      }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } },
      "24": { "$value": { "value": 96, "unit": "px" } }
    },
    "size": {
      "controlMinimum": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } },
      "iconSmall": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "icon": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "contentSite": { "$type": "dimension", "$value": { "value": 72, "unit": "rem" } },
      "contentDocs": { "$type": "dimension", "$value": { "value": 48, "unit": "rem" } },
      "contentCode": { "$type": "dimension", "$value": { "value": 72, "unit": "rem" } }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "hairline": { "$value": { "value": 1, "unit": "px" } },
        "strong": { "$value": { "value": 2, "unit": "px" } },
        "gate": { "$value": { "value": 3, "unit": "px" } }
      },
      "radius": {
        "$type": "dimension",
        "small": { "$value": { "value": 4, "unit": "px" } },
        "control": { "$value": { "value": 8, "unit": "px" } },
        "panel": { "$value": { "value": 12, "unit": "px" } },
        "round": { "$value": { "value": 999, "unit": "px" } }
      }
    },
    "focus": {
      "ringWidth": { "$type": "dimension", "$value": "{shared.border.width.strong}" },
      "ringOffset": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } }
    },
    "motion": {
      "entrance": {
        "duration": { "$type": "duration", "$value": { "value": 420, "unit": "ms" } },
        "easing": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
        "distance": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
      },
      "feedback": {
        "duration": { "$type": "duration", "$value": { "value": 140, "unit": "ms" } },
        "easing": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
        "distance": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
      },
      "traversal": {
        "duration": { "$type": "duration", "$value": { "value": 760, "unit": "ms" } },
        "easing": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
        "distance": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
      },
      "reduced": {
        "entranceDuration": { "$type": "duration", "$value": { "value": 0, "unit": "ms" } },
        "entranceDistance": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "feedbackDuration": { "$type": "duration", "$value": { "value": 0, "unit": "ms" } },
        "feedbackDistance": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "traversalDuration": { "$type": "duration", "$value": { "value": 0, "unit": "ms" } },
        "traversalDistance": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      }
    },
    "topology": {
      "nodeSize": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "nodeActiveSize": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "edgeWidth": { "$type": "dimension", "$value": "{shared.border.width.hairline}" },
      "edgeActiveWidth": { "$type": "dimension", "$value": "{shared.border.width.strong}" },
      "gateWidth": { "$type": "dimension", "$value": "{shared.border.width.gate}" },
      "checkpointSize": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "laneGap": { "$type": "dimension", "$value": "{shared.space.8}" },
      "evidenceWidth": { "$type": "dimension", "$value": "{shared.border.width.strong}" }
    }
  },
  "surface": {
    "site": {
      "color": {
        "$type": "color",
        "canvas": { "$value": "{private.color.inkBlack}" },
        "canvasRaised": { "$value": "{private.color.inkRaised}" },
        "text": { "$value": "{private.color.coolWhite}" },
        "textMuted": { "$value": "{private.color.coolWhiteMuted}" },
        "link": { "$value": "{private.color.spectralBlueBright}" },
        "linkHover": { "$value": "{private.color.copperBright}" },
        "border": { "$value": "{private.color.graphiteDark}" },
        "borderStrong": { "$value": "{private.color.graphiteStrong}" },
        "focus": { "$value": "{private.color.coolWhite}" },
        "focusContrast": { "$value": "{private.color.inkBlack}" },
        "selectionBackground": { "$value": "{private.color.spectralBlueDeep}" },
        "selectionText": { "$value": "{private.color.coolWhite}" },
        "statusSuccess": { "$value": "{private.color.evidenceBright}" },
        "statusWarning": { "$value": "{private.color.copperBright}" },
        "statusDanger": { "$value": "{private.color.dangerBright}" },
        "statusInfo": { "$value": "{private.color.spectralBlueBright}" },
        "graphNode": { "$value": "{private.color.graphiteStrong}" },
        "graphNodeActive": { "$value": "{private.color.spectralBlueBright}" },
        "graphNodeComplete": { "$value": "{private.color.evidenceBright}" },
        "graphNodeBlocked": { "$value": "{private.color.dangerBright}" },
        "graphEdge": { "$value": "{private.color.graphiteStrong}" },
        "graphEdgeActive": { "$value": "{private.color.copperBright}" },
        "gate": { "$value": "{private.color.copperBright}" },
        "checkpoint": { "$value": "{private.color.spectralBlueBright}" },
        "evidence": { "$value": "{private.color.evidenceBright}" }
      }
    },
    "docs": {
      "color": {
        "$type": "color",
        "canvas": { "$value": "{private.color.coolWhite}" },
        "canvasRaised": { "$value": "{private.color.coolWhiteSubtle}" },
        "text": { "$value": "{private.color.inkBlack}" },
        "textMuted": { "$value": "{private.color.graphiteMuted}" },
        "link": { "$value": "{private.color.spectralBlueDark}" },
        "linkHover": { "$value": "{private.color.spectralBlueDeep}" },
        "border": { "$value": "{private.color.coolWhiteMuted}" },
        "borderStrong": { "$value": "{private.color.graphiteLight}" },
        "focus": { "$value": "{private.color.inkBlack}" },
        "focusContrast": { "$value": "{private.color.coolWhite}" },
        "selectionBackground": { "$value": "{private.color.spectralBlueDeep}" },
        "selectionText": { "$value": "{private.color.coolWhite}" },
        "statusSuccess": { "$value": "{private.color.evidenceDark}" },
        "statusWarning": { "$value": "{private.color.copperDark}" },
        "statusDanger": { "$value": "{private.color.dangerDark}" },
        "statusInfo": { "$value": "{private.color.spectralBlueDark}" },
        "graphNode": { "$value": "{private.color.graphiteMuted}" },
        "graphNodeActive": { "$value": "{private.color.spectralBlueDark}" },
        "graphNodeComplete": { "$value": "{private.color.evidenceDark}" },
        "graphNodeBlocked": { "$value": "{private.color.dangerDark}" },
        "graphEdge": { "$value": "{private.color.graphiteLight}" },
        "graphEdgeActive": { "$value": "{private.color.copperDark}" },
        "gate": { "$value": "{private.color.copperDark}" },
        "checkpoint": { "$value": "{private.color.spectralBlueDark}" },
        "evidence": { "$value": "{private.color.evidenceDark}" }
      }
    }
  }
}
