{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Ariadnev design tokens. Authored in DTCG with OKLCH colour. This file is the single source; packages/tokens/dist/*.css is generated and must never be hand-edited.\n\nDesign thesis — Prismatic Technical Dossier: explicit brand, reading, instrument, and overlay contexts combine Swiss editorial clarity with industrial utility. Blue means interactive/current execution, green verified success, red error/destructive, and restrained copper human approval or blocked attention.",

  "color": {
    "$type": "color",
    "ink": {
      "$description": "The ground. Everything is drawn on ink, never on pure black.",
      "900": { "$value": "oklch(0.16 0.018 264)" },
      "800": { "$value": "oklch(0.21 0.020 264)" },
      "700": { "$value": "oklch(0.27 0.022 264)" },
      "scrim": { "$value": "oklch(0.10 0.02 264 / 0.65)" }
    },
    "graphite": {
      "$description": "Structure: edges, rules, inactive topology.",
      "600": { "$value": "oklch(0.44 0.014 264)" },
      "500": { "$value": "oklch(0.56 0.012 264)" },
      "400": { "$value": "oklch(0.70 0.010 264)" }
    },
    "cool": {
      "$description": "Surfaces and text on ink.",
      "100": { "$value": "oklch(0.97 0.004 264)" },
      "200": { "$value": "oklch(0.93 0.006 264)" },
      "300": { "$value": "oklch(0.86 0.008 264)" }
    },
    "paper": {
      "$description": "Warm-neutral editorial reading fields. Never used as a global theme flip.",
      "50": { "$value": "oklch(0.985 0.008 82)" },
      "100": { "$value": "oklch(0.955 0.010 82)" },
      "200": { "$value": "oklch(0.895 0.012 82)" }
    },
    "spectral": {
      "$description": "Live execution: an active path, a running node, a resolved witness.",
      "700": { "$value": "oklch(0.43 0.150 252)" },
      "600": { "$value": "oklch(0.55 0.170 252)" },
      "500": { "$value": "oklch(0.65 0.165 252)" },
      "400": { "$value": "oklch(0.76 0.130 252)" }
    },
    "copper": {
      "$description": "Human gates: approval required, held, awaiting a decision.",
      "700": { "$value": "oklch(0.42 0.105 58)" },
      "600": { "$value": "oklch(0.56 0.130 58)" },
      "500": { "$value": "oklch(0.68 0.135 58)" },
      "400": { "$value": "oklch(0.79 0.105 58)" }
    },
    "signal": {
      "$description": "Outcome states. Deliberately narrow: cartography carries meaning, colour only confirms it.",
      "pass": { "$value": "oklch(0.72 0.150 155)" },
      "passOnLight": { "$value": "oklch(0.40 0.120 155)" },
      "fail": { "$value": "oklch(0.68 0.180 25)" },
      "failOnLight": { "$value": "oklch(0.44 0.160 25)" },
      "blocked": { "$value": "oklch(0.79 0.105 58)" }
    }
  },

  "context": {
    "$type": "color",
    "$description": "Explicit authored surface contexts. Owning regions declare data-surface-context; behavior code never branches on context. Every matrix exposes the same paired roles so components inherit semantics without a global light/dark switch.",
    "brand": {
      "canvas": { "$value": "{color.ink.900}" },
      "raised": { "$value": "{color.ink.800}" },
      "border": { "$value": "{color.graphite.600}" },
      "borderStrong": { "$value": "{color.graphite.500}" },
      "text": { "primary": { "$value": "{color.cool.100}" }, "muted": { "$value": "{color.cool.300}" } },
      "link": { "default": { "$value": "{color.spectral.400}" }, "hover": { "$value": "{color.cool.100}" } },
      "focus": { "ring": { "$value": "{color.spectral.400}" } },
      "selection": { "layer": { "$value": "{color.spectral.400}" }, "text": { "$value": "{color.ink.900}" } },
      "disabled": { "layer": { "$value": "{color.ink.800}" }, "text": { "$value": "{color.graphite.500}" }, "border": { "$value": "{color.graphite.600}" } },
      "active": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.spectral.400}" }, "indicator": { "$value": "{color.spectral.400}" } },
      "verified": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.signal.pass}" }, "indicator": { "$value": "{color.signal.pass}" } },
      "gate": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.copper.400}" }, "indicator": { "$value": "{color.copper.400}" } },
      "destructive": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.signal.fail}" }, "indicator": { "$value": "{color.signal.fail}" } }
    },
    "reading": {
      "canvas": { "$value": "{color.paper.50}" },
      "raised": { "$value": "{color.paper.100}" },
      "border": { "$value": "{color.paper.200}" },
      "borderStrong": { "$value": "{color.graphite.600}" },
      "text": { "primary": { "$value": "{color.ink.900}" }, "muted": { "$value": "{color.ink.700}" } },
      "link": { "default": { "$value": "{color.spectral.700}" }, "hover": { "$value": "{color.ink.900}" } },
      "focus": { "ring": { "$value": "{color.spectral.700}" } },
      "selection": { "layer": { "$value": "{color.spectral.400}" }, "text": { "$value": "{color.ink.900}" } },
      "disabled": { "layer": { "$value": "{color.paper.100}" }, "text": { "$value": "{color.graphite.600}" }, "border": { "$value": "{color.paper.200}" } },
      "active": { "layer": { "$value": "{color.paper.100}" }, "text": { "$value": "{color.spectral.700}" }, "indicator": { "$value": "{color.spectral.700}" } },
      "verified": { "layer": { "$value": "{color.paper.100}" }, "text": { "$value": "{color.signal.passOnLight}" }, "indicator": { "$value": "{color.signal.passOnLight}" } },
      "gate": { "layer": { "$value": "{color.paper.100}" }, "text": { "$value": "{color.copper.700}" }, "indicator": { "$value": "{color.copper.700}" } },
      "destructive": { "layer": { "$value": "{color.paper.100}" }, "text": { "$value": "{color.signal.failOnLight}" }, "indicator": { "$value": "{color.signal.failOnLight}" } }
    },
    "instrument": {
      "canvas": { "$value": "{color.ink.900}" },
      "raised": { "$value": "{color.ink.800}" },
      "border": { "$value": "{color.graphite.600}" },
      "borderStrong": { "$value": "{color.graphite.500}" },
      "text": { "primary": { "$value": "{color.cool.100}" }, "muted": { "$value": "{color.cool.300}" } },
      "link": { "default": { "$value": "{color.spectral.400}" }, "hover": { "$value": "{color.cool.100}" } },
      "focus": { "ring": { "$value": "{color.spectral.400}" } },
      "selection": { "layer": { "$value": "{color.spectral.400}" }, "text": { "$value": "{color.ink.900}" } },
      "disabled": { "layer": { "$value": "{color.ink.800}" }, "text": { "$value": "{color.graphite.500}" }, "border": { "$value": "{color.graphite.600}" } },
      "active": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.spectral.400}" }, "indicator": { "$value": "{color.spectral.400}" } },
      "verified": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.signal.pass}" }, "indicator": { "$value": "{color.signal.pass}" } },
      "gate": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.copper.400}" }, "indicator": { "$value": "{color.copper.400}" } },
      "destructive": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.signal.fail}" }, "indicator": { "$value": "{color.signal.fail}" } }
    },
    "overlay": {
      "canvas": { "$value": "{color.ink.800}" },
      "raised": { "$value": "{color.ink.700}" },
      "scrim": { "$value": "{color.ink.scrim}" },
      "border": { "$value": "{color.graphite.500}" },
      "borderStrong": { "$value": "{color.graphite.400}" },
      "text": { "primary": { "$value": "{color.cool.100}" }, "muted": { "$value": "{color.cool.300}" } },
      "link": { "default": { "$value": "{color.spectral.400}" }, "hover": { "$value": "{color.cool.100}" } },
      "focus": { "ring": { "$value": "{color.spectral.400}" } },
      "selection": { "layer": { "$value": "{color.spectral.400}" }, "text": { "$value": "{color.ink.900}" } },
      "disabled": { "layer": { "$value": "{color.ink.800}" }, "text": { "$value": "{color.graphite.500}" }, "border": { "$value": "{color.graphite.600}" } },
      "active": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.spectral.400}" }, "indicator": { "$value": "{color.spectral.400}" } },
      "verified": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.signal.pass}" }, "indicator": { "$value": "{color.signal.pass}" } },
      "gate": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.copper.400}" }, "indicator": { "$value": "{color.copper.400}" } },
      "destructive": { "layer": { "$value": "{color.ink.700}" }, "text": { "$value": "{color.signal.fail}" }, "indicator": { "$value": "{color.signal.fail}" } }
    }
  },

  "surface": {
    "$type": "color",
    "$description": "Semantic surface roles. Apps consume these, never a raw palette step.",
    "canvas": { "$value": "{color.ink.900}" },
    "raised": { "$value": "{color.ink.800}" },
    "overlay": { "$value": "{color.ink.700}" },
    "border": { "$value": "{color.graphite.600}" },
    "borderStrong": { "$value": "{color.graphite.500}" }
  },

  "text": {
    "$type": "color",
    "$description": "Text roles on the canvas. Contrast against surface.canvas is asserted by tests/tokens/token-contract.test.mjs.",
    "primary": { "$value": "{color.cool.100}" },
    "secondary": { "$value": "{color.cool.300}" },
    "muted": { "$value": "{color.graphite.400}" },
    "accent": { "$value": "{color.spectral.400}" },
    "gate": { "$value": "{color.copper.400}" },
    "onAccent": { "$value": "{color.ink.900}" }
  },

  "topology": {
    "$type": "color",
    "$description": "The execution graph itself. A path witness is the record that a given edge was actually taken.",
    "node": { "$value": "{color.ink.700}" },
    "nodeActive": { "$value": "{color.spectral.600}" },
    "edge": { "$value": "{color.graphite.600}" },
    "edgeActive": { "$value": "{color.spectral.500}" },
    "gate": { "$value": "{color.copper.500}" },
    "checkpoint": { "$value": "{color.cool.300}" },
    "witness": { "$value": "{color.spectral.400}" }
  },

  "state": {
    "$type": "color",
    "$description": "Interactive state layers. NOT every state gets a unique colour — the token set carries meaning in layer + border + text + indicator roles so shape and text can share the burden with colour. Apps consume state.* aliases; screens never restate a raw palette step for a state.",
    "hover": {
      "$description": "A subtle raise, not a highlight. The layer sits ON TOP of surface.canvas / surface.raised.",
      "layer": { "$value": "{color.ink.700}" },
      "border": { "$value": "{color.graphite.500}" }
    },
    "pressed": {
      "$description": "A deeper depression than hover; readers should feel one click of extra weight.",
      "layer": { "$value": "{color.ink.800}" },
      "border": { "$value": "{color.graphite.500}" }
    },
    "selected": {
      "$description": "A held selection (e.g. a chosen row, a picked filter). Selection is a DIFFERENT state from current — current is the reader's own position; selected is a chosen value. The layer uses spectral.400 (bright accent chip) so ink text on top clears 4.5:1 contrast; text aliases the existing text.onAccent role.",
      "layer": { "$value": "{color.spectral.400}" },
      "border": { "$value": "{color.spectral.500}" },
      "text": { "$value": "{text.onAccent}" }
    },
    "current": {
      "$description": "The reader's own position in navigation, breadcrumb, sibling list, or TOC. Carried as a left/inline indicator bar; NEVER a fill, so nav-current does not collide visually with selection.",
      "indicator": { "$value": "{color.spectral.400}" },
      "text": { "$value": "{color.cool.100}" }
    },
    "disabled": {
      "$description": "Non-interactive. Contrast intentionally drops; disabled elements are not required to meet 4.5:1 on text, per WCAG 2.2 disabled-control exemption. Still visible enough to read.",
      "layer": { "$value": "{color.ink.800}" },
      "text": { "$value": "{color.graphite.500}" },
      "border": { "$value": "{color.graphite.600}" }
    },
    "loading": {
      "$description": "In-flight work: a spinner, a determinate/indeterminate progress bar. Loading uses spectral to match live-execution semantics.",
      "indicator": { "$value": "{color.spectral.500}" },
      "track": { "$value": "{color.ink.700}" }
    },
    "success": {
      "$description": "An outcome-confirmed state. Distinct from copy-success (which is a transient toast) — success here marks the persistent status of a completed operation.",
      "text": { "$value": "{color.signal.pass}" },
      "border": { "$value": "{color.signal.pass}" },
      "layer": { "$value": "{color.ink.700}" }
    },
    "error": {
      "$description": "A failed operation. Distinct from destructive — destructive is a boundary before action; error is a resulting state.",
      "text": { "$value": "{color.signal.fail}" },
      "border": { "$value": "{color.signal.fail}" },
      "layer": { "$value": "{color.ink.700}" }
    },
    "destructive": {
      "$description": "A boundary marker for an irreversible action (rm, drop, force-push, delete). MUST render before the action fires, not after. Uses signal.fail hue for hazard recognition.",
      "text": { "$value": "{color.signal.fail}" },
      "border": { "$value": "{color.signal.fail}" },
      "indicator": { "$value": "{color.signal.fail}" }
    },
    "copySuccess": {
      "$description": "The transient copy-to-clipboard witness. Distinct from execution witness so the visual meanings don't collide — copySuccess is 'we did the local UI thing', witness is 'the remote/server thing was recorded'.",
      "indicator": { "$value": "{color.signal.pass}" }
    }
  },

  "content": {
    "$type": "color",
    "$description": "Content-surface roles for code, data, callouts, and empty/error states. These wrap surface aliases with content-specific semantics so a screen author writes `content.code.background`, not `color.ink.700`.",
    "code": {
      "$description": "Fenced code / command surface. Uses ink.800 (one step raised from canvas) so it reads as a distinct region on both surface.canvas and surface.raised parents.",
      "background": { "$value": "{color.ink.800}" },
      "text": { "$value": "{color.cool.100}" },
      "border": { "$value": "{color.graphite.600}" },
      "prompt": { "$value": "{color.spectral.400}" }
    },
    "codeInline": {
      "$description": "Inline `code` chip. Slightly smaller inset than a fenced block.",
      "background": { "$value": "{color.ink.700}" },
      "text": { "$value": "{color.cool.100}" }
    },
    "table": {
      "$description": "Data table surfaces. Rows do NOT alternate by default; a stripe is available for very-long tables when the eye needs a rest line.",
      "header": { "$value": "{color.ink.800}" },
      "headerText": { "$value": "{color.cool.100}" },
      "row": { "$value": "{color.ink.900}" },
      "rowStripe": { "$value": "{color.ink.800}" },
      "divider": { "$value": "{color.graphite.600}" },
      "scrollAffordance": { "$value": "{color.spectral.400}" }
    },
    "callout": {
      "$description": "Five named callouts. Each carries a distinct semantic — do not add a sixth without an accepted decision-doc addendum.",
      "note": {
        "layer": { "$value": "{color.ink.800}" },
        "border": { "$value": "{color.graphite.500}" },
        "text": { "$value": "{color.cool.100}" },
        "label": { "$value": "{color.cool.300}" }
      },
      "gate": {
        "layer": { "$value": "{color.ink.800}" },
        "border": { "$value": "{color.copper.500}" },
        "text": { "$value": "{color.cool.100}" },
        "label": { "$value": "{color.copper.400}" }
      },
      "boundary": {
        "layer": { "$value": "{color.ink.800}" },
        "border": { "$value": "{color.graphite.500}" },
        "text": { "$value": "{color.cool.100}" },
        "label": { "$value": "{color.spectral.400}" }
      },
      "destructive": {
        "layer": { "$value": "{color.ink.800}" },
        "border": { "$value": "{color.signal.fail}" },
        "text": { "$value": "{color.cool.100}" },
        "label": { "$value": "{color.signal.fail}" }
      },
      "evidence": {
        "layer": { "$value": "{color.ink.800}" },
        "border": { "$value": "{color.graphite.500}" },
        "text": { "$value": "{color.cool.100}" },
        "label": { "$value": "{color.signal.pass}" }
      }
    },
    "overlay": {
      "$description": "Modal, drawer, and popover surfaces. Overlay uses ink.700 so it reads above the canvas without a glow.",
      "background": { "$value": "{color.ink.700}" },
      "border": { "$value": "{color.graphite.500}" },
      "scrim": { "$value": "{color.ink.scrim}" }
    },
    "selection": {
      "$description": "Text-selection background (the browser default is usually opinionated; we override it once, here).",
      "background": { "$value": "{color.spectral.600}" },
      "text": { "$value": "{color.ink.900}" }
    },
    "empty": {
      "$description": "Empty-state surface (no rows, no results, no matches).",
      "text": { "$value": "{color.cool.300}" },
      "border": { "$value": "{color.graphite.600}" }
    },
    "errorSurface": {
      "$description": "Non-inline error surface (e.g. a failed panel). Distinct name from state.error so a screen can compose both — one is the visual container, the other is the state alias applied to controls inside it.",
      "layer": { "$value": "{color.ink.800}" },
      "border": { "$value": "{color.signal.fail}" },
      "text": { "$value": "{color.cool.100}" },
      "label": { "$value": "{color.signal.fail}" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "Prismatic hierarchy: Be Vietnam Pro is the editorial display voice, Inter is the reading and interface workhorse, and JetBrains Mono is reserved for commands, records, identifiers, and tabular instrumentation.",
      "display": { "$value": ["Be Vietnam Pro", "system-ui", "sans-serif"] },
      "body": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Inter body is a variable face pinned 400..700 in the manifest; `medium` (500) is a legitimate axis position, not a fake alias. The display face (Be Vietnam Pro) is a single 700 asset — do NOT add a display-medium role; use text-size, spacing, and color for hierarchy instead.",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "A fifth-major scale. Body is 1rem; nothing below 0.875rem is used for prose.",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.5625rem" },
      "2xl": { "$value": "1.953rem" },
      "3xl": { "$value": "2.441rem" },
      "4xl": { "$value": "3.052rem" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.6 },
      "relaxed": { "$value": 1.75 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.06em" }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "A strict 4px base grid. Every spacing value is a multiple of 0.25rem.",
    "0": { "$value": "0rem" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" },
    "9": { "$value": "6rem" },
    "10": { "$value": "8rem" }
  },

  "size": {
    "$type": "dimension",
    "$description": "Interaction sizing. touchTarget is the WCAG 2.2 target-size floor and is asserted by tests.",
    "touchTarget": { "$value": "2.75rem" },
    "contentMax": { "$value": "72rem" },
    "proseMax": { "$value": "38rem" },
    "referenceMax": { "$value": "56rem" }
  },

  "layout": {
    "$type": "dimension",
    "$description": "Shared shell/composition dimensions. Values on the 4px grid or documented if not. Marked shared vs app-local in docs/decisions/state-layers-content-surfaces-and-dimensions.md.",
    "docs": {
      "$description": "The docs shell composition. Shared across both apps' documentation rendering.",
      "headerHeight": { "$value": "3.5rem" },
      "sidebarWidth": { "$value": "16rem" },
      "tocWidth": { "$value": "13rem" },
      "stickyOffset": { "$value": "4rem" },
      "railViewportHeight": { "$value": "calc(100vh - 4rem)" }
    },
    "table": {
      "$description": "Data-table column constraints. Rows never scroll horizontally on the page; the table itself carries a local scroll affordance.",
      "columnMin": { "$value": "8rem" },
      "columnMax": { "$value": "22rem" }
    },
    "marketing": {
      "$description": "Marketing surface composition gaps for split/path/ledger sections. app-local: only the site consumes these; docs never composes marketing gaps.",
      "splitGap": { "$value": "2rem" },
      "pathGap": { "$value": "3rem" },
      "ledgerGap": { "$value": "1.5rem" }
    },
    "density": {
      "$description": "Row / list densities. Compact for tight reference; prose for reading; reference for the CLI options tables. All ≥ touchTarget where the row is interactive.",
      "compactRow": { "$value": "2rem" },
      "proseRow": { "$value": "2.75rem" },
      "referenceRow": { "$value": "3rem" }
    }
  },

  "border": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": "1px" },
      "thick": { "$value": "2px" }
    },
    "radius": {
      "$type": "dimension",
      "$description": "Geometric, not soft. The largest radius is deliberately small; cartography reads as drafted, not rounded.",
      "none": { "$value": "0rem" },
      "sm": { "$value": "0.125rem" },
      "md": { "$value": "0.25rem" },
      "lg": { "$value": "0.5rem" },
      "pill": { "$value": "999rem" }
    }
  },

  "focus": {
    "$description": "A single focus treatment across both apps. The ring must never be removed, only re-coloured on a light surface.",
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" },
    "color": { "$type": "color", "$value": "{color.spectral.400}" },
    "colorOnLight": { "$type": "color", "$value": "{color.spectral.600}" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Short by design. Anything above 400ms reads as latency rather than feedback.",
      "instant": { "$value": "80ms" },
      "fast": { "$value": "150ms" },
      "normal": { "$value": "240ms" },
      "slow": { "$value": "400ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0, 1] },
      "exit": { "$value": [0.3, 0, 1, 1] }
    }
  },

  "elevation": {
    "$type": "shadow",
    "$description": "Elevation is drawn with a hairline and a soft ground shadow, never with a glow.",
    "raised": {
      "$value": { "color": "oklch(0.10 0.02 264 / 0.45)", "offsetX": "0rem", "offsetY": "0.0625rem", "blur": "0.125rem", "spread": "0rem" }
    },
    "overlay": {
