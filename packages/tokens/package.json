{
  "name": "@ariadnev-web/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared design tokens consumed by both apps. Implementation arrives in Phase 5; the package boundary, exports, and scripts are pinned here so Phase 5 needs no lockfile edit.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./site.css": "./dist/site.css",
    "./docs.css": "./dist/docs.css",
    "./font-manifest.json": "./src/font-manifest.json",
    "./assets/*": "./assets/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "src/font-manifest.json"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs && tsc --build",
    "check": "node scripts/build-tokens.mjs --check && tsc --build --force",
    "test": "node --test ../../tests/tokens/*.test.mjs"
  }
}
