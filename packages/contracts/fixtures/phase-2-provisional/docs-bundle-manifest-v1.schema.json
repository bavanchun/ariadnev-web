{
  "$defs": {
    "payloadEntry": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 524288,
          "minimum": 1,
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "path": {
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+(?<!/)$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "digest"
      ],
      "type": "object"
    }
  },
  "$id": "https://vcskill.dev/schemas/docs-bundle-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "final"
          }
        }
      },
      "then": {
        "properties": {
          "publishable": {
            "const": true
          },
          "releaseTag": {
            "pattern": "^vcskill@[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "provisional"
          }
        }
      },
      "then": {
        "properties": {
          "publishable": {
            "const": false
          },
          "releaseTag": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "bundle": {
      "const": "vcskill-docs-bundle"
    },
    "fileCount": {
      "maximum": 128,
      "minimum": 1,
      "type": "integer"
    },
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "generatorSha": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "mode": {
      "enum": [
        "final",
        "provisional"
      ]
    },
    "payload": {
      "items": {
        "$ref": "#/$defs/payloadEntry"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "proofBoundary": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "publishable": {
      "type": "boolean"
    },
    "releaseTag": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^vcskill@[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "type": "string"
        }
      ]
    },
    "schemaId": {
      "const": "https://vcskill.dev/schemas/docs-bundle-manifest-v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceDateEpoch": {
      "minimum": 0,
      "type": "integer"
    },
    "sourceSha": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "totalBytes": {
      "maximum": 4194304,
      "minimum": 1,
      "type": "integer"
    },
    "version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "schemaId",
    "bundle",
    "mode",
    "publishable",
    "version",
    "releaseTag",
    "sourceSha",
    "generatorSha",
    "generatedAt",
    "sourceDateEpoch",
    "proofBoundary",
    "fileCount",
    "totalBytes",
    "payload"
  ],
  "title": "vcskill docs bundle manifest v1",
  "type": "object"
}
