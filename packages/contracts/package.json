  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
