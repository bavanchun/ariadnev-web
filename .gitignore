# Dependencies
node_modules/

# Build output
dist/
.astro/
.next/
.output/
.vercel/
apps/*/dist/
packages/*/dist/
# ...except the generated token stylesheets, which are committed so a drift test
# can compare them against a fresh build. Compiled JS and declarations stay out.
!packages/tokens/dist/
packages/tokens/dist/*
!packages/tokens/dist/*.css

# Wrangler
.wrangler/
.dev.vars
.dev.vars.*

# Local environment
.env
.env.*
!.env.example

# Temporary extraction and spike scratch space
.tmp/
.spike-evidence/
*.tmp

# Test and tooling caches
coverage/
.vitest/
node_modules/.cache/

# OS noise
.DS_Store

# Per-machine agent scratch memory. Reports under plans/ stay tracked.
.claude/agent-memory/

# Release locks and lockfiles stay tracked on purpose:
#   pnpm-lock.yaml, deployment/topology.json, docs/decisions/*.json

# Docs app: Next static export, the fumadocs-mdx collection, and the generated
# content root the release docs bundle produces. Authored content stays tracked.
apps/docs/out/
apps/docs/.source/
apps/docs/content/generated/
apps/docs/content/.staging/
*.tsbuildinfo

# Playwright visual harness (Phase 7)
tests/visual/.artifacts/
tests/visual/.playwright-cache/
playwright-report/
