# Pin the Node runtime pnpm uses so local runs, CI, and deploys all execute the
# same interpreter. Without this pnpm may resolve its own newer Node and quietly
# diverge from the version `engines.node` and CI declare.
use-node-version=24.15.0

# Exact versions only. A caret or tilde would let an install drift from the
# committed lockfile's intent.
save-exact=true
