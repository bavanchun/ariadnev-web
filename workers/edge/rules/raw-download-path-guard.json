{
  "schemaVersion": 1,
  "phase": "http_request_firewall_custom",
  "description": "Block raw dot segments in the protected download namespace before URL normalization",
  "action": "block",
  "environments": {
    "staging": {
      "hostname": "staging.vcskill.vchun.dev",
      "enabled": true
    },
    "production": {
      "hostname": "vcskill.vchun.dev",
      "enabled": false
    }
  },
  "rawDotSegmentVariants": [
    ".",
    "%2e",
    "..",
    ".%2e",
    "%2e.",
    "%2e%2e"
  ]
}
